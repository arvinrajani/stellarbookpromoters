# Google Sheets Integration
# Follow GOOGLE_SHEETS_SETUP.md for setup instructions

# Your Google Sheet ID (from the URL)
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# Service Account Email (from the JSON key file)
GOOGLE_SHEETS_CLIENT_EMAIL=your_service_account@project.iam.gserviceaccount.com

# Private Key (from the JSON key file)
# IMPORTANT: Replace \n with actual newlines
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"